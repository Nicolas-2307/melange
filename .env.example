# =============================================================================
# Melange — variables de entorno
# -----------------------------------------------------------------------------
# 1. Copia este archivo a `.env.local`  (Windows: Copy-Item .env.example .env.local
#                                       macOS/Linux: cp .env.example .env.local)
# 2. Pega tus valores reales en `.env.local`. ESE archivo nunca se versiona.
# 3. Este archivo SÍ se versiona: nunca pongas valores reales aquí.
#
# La validación vive en src/lib/env.ts (Zod). Si falta algo obligatorio, la app
# no arranca. Las variables marcadas [Paso N] se activarán en ese paso.
# NEXT_PUBLIC_* se exponen al navegador: jamás pongas secretos en ellas.
# =============================================================================

# --- General -----------------------------------------------------------------
# URL pública del sitio (sin "/" final). Local: http://localhost:3000
# En Vercel Preview NO se define: la app usa la URL de la rama (VERCEL_BRANCH_URL).
# En Production: el dominio propio (Paso 6b).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp (pedido alternativo) -------------------------------------------
# Número del negocio con indicativo 57, sin "+" ni espacios. Ej: 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=570000000000

# --- Selección de proveedores (cambiar proveedor = cambiar esta variable) ----
# Pagos: "whatsapp" (sin pasarela). "wompi" se habilita en el Paso 4.4.
PAYMENT_PROVIDER=whatsapp
# Imágenes: "cloudinary"
STORAGE_PROVIDER=cloudinary
# Correo: "console" (imprime en la terminal, solo desarrollo)
EMAIL_PROVIDER=console

# --- Base de datos: PostgreSQL en Neon ----------------------------------------
# Neon → tu proyecto → botón "Connect" → elige la rama (dev) y copia la cadena.
# Cambia "sslmode=require" por "sslmode=verify-full" (mismo nivel de seguridad, sin advertencia).
# Con "Connection pooling" ACTIVADO (host con "-pooler"): la usa la app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Con "Connection pooling" DESACTIVADO (host sin "-pooler"): la usa Prisma para migraciones.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full

# --- Autenticación: Better Auth -----------------------------------------------
# Secreto para firmar sesiones (mínimo 32 caracteres aleatorios). Uno distinto por ambiente.
# Generar (Windows, macOS y Linux):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Correos de administradores, separados por comas. Ej: tu@correo.com,dueno@correo.com
# Cada cuenta recibe el rol ADMIN cuando CONFIRMA su correo (en desarrollo, el enlace de
# confirmación aparece en la terminal de `npm run dev`). Quitar un correo de aquí NO le quita
# el rol a quien ya lo tiene: eso se hace en `npm run db:studio` (users → role).
ADMIN_EMAILS=

# --- Imágenes: Cloudinary [Paso 5] -------------------------------------------
# Cloudinary → Settings → API Keys.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Pagos: Wompi [Paso 4] ---------------------------------------------------
# Wompi Comercios → Desarrolladores. En desarrollo usa las llaves de PRUEBAS
# (prefijos pub_test_ / prv_test_ / test_events_ / test_integrity_).
# NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# Secreto para verificar la firma de los webhooks (eventos).
# WOMPI_EVENTS_SECRET=test_events_...
# Secreto de integridad para firmar el monto/referencia del checkout.
# WOMPI_INTEGRITY_SECRET=test_integrity_...
# URL base de la API: sandbox https://sandbox.wompi.co/v1 | producción https://production.wompi.co/v1
# WOMPI_API_URL=https://sandbox.wompi.co/v1
